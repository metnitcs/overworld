# Copy to server/.env and adjust. server/.env is gitignored.
DATABASE_URL=postgresql://asura:dev@localhost:5432/asura
JWT_SECRET=replace-with-a-random-32-byte-base64-secret
REDIS_URL=redis://localhost:6379
PORT=3000
HOST=0.0.0.0
# Comma-separated usernames auto-promoted to ADMIN on register/login.
# Leave empty in production unless you really mean it. Slice 20 (L3 admin).
ADMIN_USERS=admin
