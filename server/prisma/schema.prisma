// Prisma schema for asura-online (Phase 2). See PLAN.md §3 Phase 2.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

/// Slice 30: account lifecycle status.
/// ACTIVE = normal; SUSPENDED = blocked at login until lifted; BANNED =
/// permanent block. Admin-only mutation via /api/admin/users.
enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

model User {
  id         String      @id @default(cuid())
  username   String      @unique
  password   String // bcrypt hash
  email      String?     @unique
  /// Slice 20: role-based gating for /api/admin/*. Bootstrapped via the
  /// ADMIN_USERS env (comma-separated usernames) at register/login time.
  role       Role        @default(USER)
  /// Slice 30: account status. SUSPENDED + BANNED both reject login;
  /// the difference is just the displayed reason + intent.
  status     UserStatus  @default(ACTIVE)
  createdAt  DateTime    @default(now())
  characters Character[]
}

/// Slice 30: audit trail for every admin mutation. Written by the
/// `app.audit(...)` decorator. Read-only via /api/admin/logs.
model AuditLog {
  id          String   @id @default(cuid())
  /// User who performed the action. Null = system / unauthenticated.
  actorUserId String?
  /// e.g. 'item.update', 'character.delete', 'user.suspend', 'cache.reload'
  action      String
  /// Target row type — 'item', 'monster', 'map', 'character', 'user', etc.
  targetType  String
  /// Target row id when applicable.
  targetId    String?
  /// Free-form snapshot: what changed, request payload, etc.
  payload     Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model Character {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  raceId        String
  classId       String
  lv            Int             @default(1)
  exp           Int             @default(0)
  hp            Int
  maxHp         Int
  mp            Int
  maxMp         Int
  // Slice 23: derived combat stats — cached from primary stats by deriveStats.
  // Kept in DB so legacy reads + admin queries still see the final number.
  atk           Int
  def           Int
  spd           Int
  /// Slice 23: 6 primary stats. Players allocate via [+] on Status modal;
  /// every level grants STAT_POINTS_PER_LEVEL (5) extra unspent points.
  str           Int             @default(10)
  int           Int             @default(10)
  dex           Int             @default(10)
  agi           Int             @default(10)
  luk           Int             @default(10)
  vit           Int             @default(10)
  unspentPoints Int             @default(0)
  gold          Int             @default(100)
  mapId         String          @default("village")
  px            Int             @default(5)
  py            Int             @default(5)
  steps         Int             @default(0)
  /// Slice 47: per-instance gear. Each equip*Id is a FK to the equipped
  /// InventoryItem row (not itemKey). Unique on each side so a given
  /// InventoryItem can only be equipped by one Character at a time.
  /// ON DELETE SET NULL so selling/dropping an equipped item clears the
  /// slot automatically.
  /// Slice 52a: expanded from 2 slots (weapon/armor) to 9 — adds shield,
  /// helmet, boots, cloak, necklace, ring×2. Per CONTEXT.md "Equipment
  /// Slot". Ring1+ring2 both accept ItemType=`ring`; the equip endpoint
  /// auto-fills the empty slot first.
  equipWeaponId   String?         @unique
  equipWeapon     InventoryItem?  @relation("EquipWeapon", fields: [equipWeaponId], references: [id], onDelete: SetNull)
  equipArmorId    String?         @unique
  equipArmor      InventoryItem?  @relation("EquipArmor", fields: [equipArmorId], references: [id], onDelete: SetNull)
  equipShieldId   String?         @unique
  equipShield     InventoryItem?  @relation("EquipShield", fields: [equipShieldId], references: [id], onDelete: SetNull)
  equipHelmetId   String?         @unique
  equipHelmet     InventoryItem?  @relation("EquipHelmet", fields: [equipHelmetId], references: [id], onDelete: SetNull)
  equipBootsId    String?         @unique
  equipBoots      InventoryItem?  @relation("EquipBoots", fields: [equipBootsId], references: [id], onDelete: SetNull)
  equipCloakId    String?         @unique
  equipCloak      InventoryItem?  @relation("EquipCloak", fields: [equipCloakId], references: [id], onDelete: SetNull)
  equipNecklaceId String?         @unique
  equipNecklace   InventoryItem?  @relation("EquipNecklace", fields: [equipNecklaceId], references: [id], onDelete: SetNull)
  equipRing1Id    String?         @unique
  equipRing1      InventoryItem?  @relation("EquipRing1", fields: [equipRing1Id], references: [id], onDelete: SetNull)
  equipRing2Id    String?         @unique
  equipRing2      InventoryItem?  @relation("EquipRing2", fields: [equipRing2Id], references: [id], onDelete: SetNull)
  /// Slice 17: true after the Lv 10 race-change quest has resolved. Gates
  /// the RaceChangeModal so it fires exactly once.
  transcended   Boolean         @default(false)
  /// Slice 26: true after the Lv 5 class-change quest has resolved.
  /// New characters start as STARTER_CLASS ('adventurer') and pick a real
  /// advanced class via the ClassChoiceModal at threshold lv. Mirrors the
  /// `transcended` flag's once-per-character lifecycle.
  classChanged  Boolean         @default(false)
  inventory     InventoryItem[] @relation("CharacterInventory")
  battleLogs    BattleLog[]
  updatedAt     DateTime        @updatedAt

  @@index([userId])
}

/// Slice 47: per-instance for weapon/armor (one row = one physical item,
/// qty always 1, carries its own `plus`); stack-by-itemKey for mat/consume
/// (one row per (characterId, itemKey) with qty). Stack policy is enforced
/// by the `addItem` server helper, not by a DB constraint, because we need
/// both shapes in the same table. See ADR 0003.
model InventoryItem {
  id                   String     @id @default(cuid())
  characterId          String
  character            Character  @relation("CharacterInventory", fields: [characterId], references: [id], onDelete: Cascade)
  itemKey              String // e.g. 'potion-s', 'sword-1'
  qty                  Int        @default(1)
  /// Plus level (0..10) for enhanceable gear (weapon/armor/shield/helmet).
  /// Always 0 for mat/consume/boots/cloak/necklace/ring.
  plus                 Int        @default(0)
  /// Backrefs for every Character.equip*Id FK (Prisma needs them to materialise
  /// the relation). Should be null on the vast majority of rows.
  /// Slice 52a: expanded from 2 → 9 slots.
  equippedAsWeaponOn   Character? @relation("EquipWeapon")
  equippedAsArmorOn    Character? @relation("EquipArmor")
  equippedAsShieldOn   Character? @relation("EquipShield")
  equippedAsHelmetOn   Character? @relation("EquipHelmet")
  equippedAsBootsOn    Character? @relation("EquipBoots")
  equippedAsCloakOn    Character? @relation("EquipCloak")
  equippedAsNecklaceOn Character? @relation("EquipNecklace")
  equippedAsRing1On    Character? @relation("EquipRing1")
  equippedAsRing2On    Character? @relation("EquipRing2")

  @@index([characterId, itemKey])
}

model BattleLog {
  id           String    @id @default(cuid())
  characterId  String
  character    Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  enemyName    String
  result       String // 'win' | 'lose' | 'flee'
  expGained    Int
  goldGained   Int
  itemsDropped String[] // ['silk', ...]
  createdAt    DateTime  @default(now())

  @@index([characterId])
}

// ─── Content tables (ADR 0002: DB-authoritative, seeded from shared/src/data.ts) ───

/// Slice 28: races and char-classes moved to DB so admin can edit them
/// via UI. Seed copies the shared/data.ts defaults on first migration.
model Race {
  id        String  @id // 'human', 'mara', 'god', etc.
  name      String
  emoji     String
  desc      String
  /// StatModifier: { str?, int?, dex?, agi?, luk?, vit? }. Slice 27
  /// design ships all races at {} (no stat bonus from race choice).
  modifiers Json
  /// Offered in the Lv-10 race-change modal when true.
  available Boolean @default(true)
  /// Exactly one race should carry this flag (the auto-assigned starter).
  starter   Boolean @default(false)
}

model CharClass {
  id             String  @id // 'adventurer', 'warrior', etc.
  name           String
  emoji          String
  desc           String
  /// StatModifier: growth recommendation weights (NOT auto-applied).
  growth         Json
  /// Skill: { name, mp, mult, type } — transitional, moves to Skill table later.
  skill          Json
  starter        Boolean @default(false)
  available      Boolean @default(true)
  /// Slice 27: gates which advanced classes appear in the Lv-120 quest
  /// for a player with this raceId. Null for the starter class.
  requiredRaceId String?
}

enum ItemType {
  mat
  consume
  weapon
  armor
  /// Slice 52a: expanded equipment slot types.
  /// - shield / helmet → enhanceable, contribute def (slot-typed)
  /// - boots / cloak / necklace / ring → not enhanceable; deliver stats
  ///   purely via Slice 51 per-item primary stat bonuses (bonusXxx)
  shield
  helmet
  boots
  cloak
  necklace
  ring
}

enum Rarity {
  common
  rare
  epic
  legendary
}

model Item {
  id           String        @id // 'sword-1', 'potion-s', etc.
  name         String
  emoji        String
  type         ItemType
  rarity       Rarity        @default(common)
  // Stat fields — null when the type doesn't carry that stat.
  atk          Int?
  def          Int?
  matk         Int?
  heal         Int?
  healMp       Int?
  /// Slice 51: primary stat bonuses that ride along with an equipped
  /// weapon or armor. Flat — NOT scaled by Plus (per the design call;
  /// Plus only scales atk for weapons and def for armor). When set on a
  /// mat/consume the runtime ignores them (only equip slots fold these
  /// in via deriveStats). See CONTEXT.md "Item Stat".
  bonusStr     Int?
  bonusInt     Int?
  bonusDex     Int?
  bonusAgi     Int?
  bonusLuk     Int?
  bonusVit     Int?
  desc         String
  monsterDrops MonsterDrop[]
  shopItems    ShopItem[]
  recipe       Recipe?       @relation("RecipeResult")
  recipeMats   RecipeMat[]
}

enum MonsterRank {
  normal
  elite
  boss
}

model Monster {
  id        String        @id // 'wolf-shadow', 'demon-lord', etc.
  name      String
  emoji     String
  rank      MonsterRank   @default(normal)
  lv        Int
  hp        Int
  atk       Int
  def       Int
  spd       Int
  exp       Int
  gold      Int
  drops     MonsterDrop[]
  mapSpawns MapMonster[]
}

model Map {
  id           String       @id // 'village', 'sakura', etc.
  name         String
  minLv        Int
  maxLv        Int
  w            Int
  h            Int
  bg           String
  /// Slice 21: optional path to a background image (relative to client public/,
  /// e.g. '/assets/maps/forest.png'). When set, MapScene draws it instead of
  /// the `bg` color carpet. Falls back to `bg` when missing.
  bgImage      String?
  pathColor    String?
  monsterCount Int          @default(0)
  /// 2D grid of tiles: { glyph?: string; walkable: boolean; kind?: TileKind }[][].
  /// Shape validated client-side; future slice 15 may add server-side Zod.
  layout       Json
  monsters     MapMonster[]
  warpsFrom    Warp[]       @relation("WarpFrom")
  warpsTo      Warp[]       @relation("WarpTo")
  npcs         Npc[]
}

enum NpcKind {
  shop
  healer
  /// Slice 48: gates the Enhance ceremony. See CONTEXT.md "Blacksmith".
  blacksmith
  quest
}

model Npc {
  id        String     @id // 'village-shopkeeper', 'village-healer'
  name      String
  emoji     String?
  mapId     String
  map       Map        @relation(fields: [mapId], references: [id], onDelete: Cascade)
  x         Int
  y         Int
  kind      NpcKind
  shopItems ShopItem[]

  @@unique([mapId, x, y])
  @@index([mapId])
}

model ShopItem {
  npcId  String
  npc    Npc    @relation(fields: [npcId], references: [id], onDelete: Cascade)
  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Restrict)
  price  Int

  @@id([npcId, itemId])
}

/// One crafting recipe. `id` mirrors the result Item.id (1 recipe per output
/// in slice 14 scope); future migration can split id and add a separate
/// `resultItemId` column if multiple recipes per output are needed.
model Recipe {
  id       String      @id
  result   Item        @relation("RecipeResult", fields: [id], references: [id], onDelete: Cascade)
  gold     Int
  /// `string[]` — class ids allowed to craft this; null = any class.
  classReq Json?
  mats     RecipeMat[]
}

model RecipeMat {
  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  itemId   String
  item     Item   @relation(fields: [itemId], references: [id], onDelete: Restrict)
  qty      Int

  @@id([recipeId, itemId])
}

model Warp {
  id      String  @id @default(cuid())
  mapId   String
  fromMap Map     @relation("WarpFrom", fields: [mapId], references: [id], onDelete: Cascade)
  x       Int
  y       Int
  toMapId String
  toMap   Map     @relation("WarpTo", fields: [toMapId], references: [id], onDelete: Restrict)
  tx      Int
  ty      Int
  label   String?

  @@unique([mapId, x, y])
  @@index([mapId])
}

model MapMonster {
  mapId       String
  map         Map     @relation(fields: [mapId], references: [id], onDelete: Cascade)
  monsterId   String
  monster     Monster @relation(fields: [monsterId], references: [id], onDelete: Cascade)
  /// Relative spawn weight when picking a Monster for a spawn cell.
  spawnWeight Int     @default(1)

  @@id([mapId, monsterId])
  @@index([mapId])
}

model MonsterDrop {
  id        String  @id @default(cuid())
  monsterId String
  monster   Monster @relation(fields: [monsterId], references: [id], onDelete: Cascade)
  itemId    String
  item      Item    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  chance    Float // 0.0–1.0
  minQty    Int     @default(1)
  maxQty    Int     @default(1)

  @@unique([monsterId, itemId])
  @@index([monsterId])
}
